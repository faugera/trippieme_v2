# Server only. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Neon Postgres + Better Auth. Keep all values server-only.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins. Include the production domain and, if needed, a preview domain.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
